 169          /* ============ 查表函数：RAW -> 温度(℃) ============ */
 170          
 171          /*
 172           * 二分查找 + 整数线性插值
 173           * 表是单调递增的（温度越高 RAW 越大），找 raw 落在哪两个相邻点之间
 174           */
 175          int ntc_raw_to_temp(int raw)
 176          {
 177   1          int lo, hi, mid;
 178   1          int r1, r2;
C51 COMPILER V9.54   STC8G_NTC_TABLE                                                       09/06/2026 17:01:47 PAGE 4   

 179   1          int t1, t2;
 180   1          int temp;
 181   1      
 182   1          /* 边界钳制 */
 183   1          if (raw <= raw_table[0]) {
 184   2              return NTC_T_MIN;          /* -20C */
 185   2          }
 186   1          if (raw >= raw_table[NTC_TABLE_SIZE - 1]) {
 187   2              return NTC_T_MAX;          /* 125C */
 188   2          }
 189   1      
 190   1          /* 二分：找第一个 raw_table[mid] > raw 的位置 */
 191   1          lo = 0;
 192   1          hi = NTC_TABLE_SIZE - 1;
 193   1          while (hi - lo > 1) {
 194   2              mid = (lo + hi) >> 1;
 195   2              if (raw_table[mid] <= raw) {
 196   3                  lo = mid;
 197   3              } else {
 198   3                  hi = mid;
 199   3              }
 200   2          }
 201   1          /* 此时 raw 在 raw_table[lo] 与 raw_table[hi] 之间 */
 202   1      
 203   1          r1 = raw_table[lo];
 204   1          r2 = raw_table[hi];
 205   1          t1 = lo - TEMP_OFFSET;     /* 实际温度(℃) */
 206   1          t2 = hi - TEMP_OFFSET;
 207   1      
 208   1          /* 整数线性插值：temp = t1 + (raw - r1) * (t2 - t1) / (r2 - r1) */
 209   1          if (r2 - r1 <= 1) {
 210   2              /* 两点 RAW 几乎相同（高温区压缩），取中点 */
 211   2              temp = (t1 + t2) >> 1;
 212   2          } else {
 213   2              temp = t1 + (int)(((long)(raw - r1) * (long)(t2 - t1)) / (long)(r2 - r1));
 214   2          }
 215   1      
 216   1          return temp;
 217   1      }


