   3          /**
   4           * @brief 软件微秒级延时（粗略）
   5           * @param us 延时微秒数
   6           * @note 在11.0592MHz下，由于函数调用和循环开销，小于10us的延时误差较大
   7           *       适用于大于20us的场合
   8           */
   9          void delay_us(unsigned int us)
  10          {
  11   1          unsigned int i;
  12   1          // 11.0592MHz下，一个_nop_()大约是0.09us
  13   1          // 循环体本身有开销，这里按经验值调整
  14   1          // 计算依据：(us * 11059200) / 1000000 / 循环消耗指令数
  15   1          // 循环大约消耗6个指令周期，所以： us * 11059200 / 1e6 / 6 ≈ us * 1.84
  16   1          // 为了抵消函数调用和判断的开销，这里取 us * 1.5 左右的系数
  17   1          i = (us * 3) >> 1; // 等效于 us * 1.5
  18   1          while (--i)
  19   1              _nop_();
  20   1      }
  21          
  22          /**
  23           * @brief 软件毫秒级延时（较精确）
  24           * @param ms 延时毫秒数
  25           * @note 在11.0592MHz下，Keil C51优化等级为Default时的实测值
  26           *       适合按键消抖（10~20ms）等场合
  27           */
  28          void delay_ms(unsigned int ms)
  29          {
  30   1          unsigned int i, j;
  31   1          while (ms--)
  32   1          {
  33   2              // 内层循环1140次，实测约为1ms
  34   2              // 计算：11059200 / 12 / 1000 * 1ms ≈ 921个指令周期
  35   2              // 内层循环体大约消耗0.8个指令周期，所以 921 / 0.8 ≈ 1151
  36   2              // 考虑到外层循环开销，取1140是一个经过实测校准的经验值
  37   2              for (i = 1140; i > 0; i--)
  38   2                  for (j = 1; j > 0; j--);
  39   2          }
