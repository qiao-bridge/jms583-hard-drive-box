  69          // ==================== 色环查表：温度 → 颜色 ====================
  70          typedef struct {
  71              unsigned char r;
  72              unsigned char g;
  73              unsigned char b;
  74          } RGB888;
  75          
  76          static const RGB888 color_table[13] = {
  77              {  0,   0, 255},   // 20℃ 蓝
  78              {  0, 128, 255},   // 25℃
  79              {  0, 255, 255},   // 30℃ 青
  80              {  0, 255, 128},   // 35℃
  81              {  0, 255,   0},   // 40℃ 绿
  82              {128, 255,   0},   // 45℃
  83              {255, 255,   0},   // 50℃ 黄
  84              {255, 200,   0},   // 55℃
  85              {255, 128,   0},   // 60℃ 橙
  86              {255,  64,   0},   // 65℃
  87              {255,  32,   0},   // 70℃
  88              {255,  16,   0},   // 75℃
  89              {255,   0,   0},   // 80℃ 红
  90          };
  91          
  92          static unsigned char lerp(unsigned char a, unsigned char b, unsigned char frac)
  93          {
  94   1          return a + ((unsigned int)(b - a) * frac / 32);
  95   1      }
  96          
  97          static RGB_Color temp_to_color(int avg_temp)
  98          {
  99   1          RGB_Color c;
 100   1          if (avg_temp <= 20) {
 101   2              c.r = 0;   c.g = 0;   c.b = 160;   // 蓝色，略亮
 102   2              return c;
 103   2          } else if (avg_temp >= 80) {
 104   2              c.r = 255; c.g = 0;   c.b = 0;
 105   2              return c;
 106   2          } else {
 107   2              unsigned char idx = (avg_temp - 20) / 5;
 108   2              unsigned char seg = (avg_temp - 20) % 5;
 109   2              unsigned char frac = seg * 32 / 5;
 110   2              c.r = lerp(color_table[idx].r, color_table[idx+1].r, frac);
 111   2              c.g = lerp(color_table[idx].g, color_table[idx+1].g, frac);
 112   2              c.b = lerp(color_table[idx].b, color_table[idx+1].b, frac);
 113   2              return c;
 114   2          }
 115   1      }
