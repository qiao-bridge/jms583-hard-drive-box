 117          // ==================== 主接口：流水灯 + 温度决定速度 ====================
 118          void ws2812_update_by_temp(int avg_temp)
 119          {
 120   1          unsigned char i;
 121   1          RGB_Color base_color;
 122   1          unsigned int step;          // 累加器步进（0~999，越大越快）
 123   1          RGB_Color black = {0,0,0};
 124   1      
 125   1          // 1. 获取基础颜色
 126   1          base_color = temp_to_color(avg_temp);
 127   1      
 128   1          // 2. 计算步进：温度越高，step 越大
 129   1          //    20℃ → step=2，80℃ → step=122，差距61倍
 130   1          //    你可以自行调整系数，例如改成 (avg_temp-20)*3 获得更大差距
 131   1          if (avg_temp <= 20) {
 132   2              step = 2;
 133   2          } else if (avg_temp >= 80) {
 134   2              step = 130;             // 高温最快
 135   2          } else {
 136   2              step = 2 + (avg_temp - 20) * 1;   // 20℃:2, 80℃:122
 137   2          }
 138   1      
 139   1          // 3. 累加器推进
 140   1          pos_acc += step;
 141   1          if (pos_acc >= 800) {       // 阈值800，每800步移动一格（可调）
 142   2              pos_acc -= 800;
 143   2              current_index++;
 144   2              if (current_index >= WS2812_NUM) {
 145   3                  current_index = 0;
 146   3              }
 147   2          }
 148   1      
 149   1          // 4. 设置灯阵：只有 current_index 亮，其余灭
 150   1          for (i = 0; i < WS2812_NUM; i++) {
 151   2              if (i == current_index) {
 152   3                  ws2812_send_color(i, base_color);
 153   3              } else {
 154   3                  ws2812_send_color(i, black);
 155   3              }
 156   2          }
 157   1      
 158   1          // 5. 显示
 159   1          ws2812_show_all(current_colors);
 160   1      }


