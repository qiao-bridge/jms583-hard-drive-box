  10          #define TEMP_LOW     25    /* 低于 25.0℃：风扇停转 */
  11          #define TEMP_HIGH    60    /* 高于 60.0℃：风扇满速 */
  12          #define HYSTERESIS   2     /* 2.0℃ 滞回，防止临界点频繁启停 */
  13          
  14          
  15          /* 三路权重（与 stc8g_adc.h 中 TEMP_WEIGHT 保持一致，仅用于打印说明） */
  16          
  17          /**
  18           * @brief 根据平均温度计算并设置风扇 PWM
  19           * @param  avg_temp: 加权平均温度 (0.1℃)
  20           */
  21          static void Fan_Update(int avg_temp)
  22          {
  23   1          static unsigned char last_duty = 0;
  24   1          unsigned char target;
  25   1      
  26   1          if (avg_temp < TEMP_LOW) {
  27   2              target = 0;
  28   2          } else if (avg_temp >= TEMP_HIGH) {
  29   2              target = 100;
  30   2          } else {
  31   2              /* 线性：25~60℃ 对应 0%~100% */
  32   2              target = (unsigned char)((avg_temp - TEMP_LOW) * 100L / (TEMP_HIGH - TEMP_LOW));
  33   2          }
  34   1      
  35   1          /* 迟滞：只有变化超过HYSTERESIS时才更新 */
  36   1          if (target > last_duty + HYSTERESIS) {
  37   2              last_duty = target;
  38   2          } else if (target + HYSTERESIS < last_duty) {
  39   2              last_duty = target;
  40   2          }
  41   1          timer0_pwm_setduty(last_duty);   
  42   1      }
