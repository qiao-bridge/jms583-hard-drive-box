  51          /**
  52           * @brief 设置指定GPIO引脚的电平状态
  53           * @note  操作逻辑：直接读写端口输出寄存器Px，位操作为原子指令，可在中断中安全调用
  54           */
C51 COMPILER V9.54   STC8G_GPIO                                                            09/06/2026 17:01:47 PAGE 2   

  55          bit stc8g_gpio_set_level(unsigned char port, unsigned char pin, bit level)
  56          {    
  57   1          switch(port){
  58   2              case 3:  // P3端口，你之前的逐个判断pin的写法完全保留
  59   2                  if(pin == 0)      P30 = level;
  60   2                  else if(pin == 1) P31 = level;
  61   2                  else if(pin == 2) P32 = level;
  62   2                  else if(pin == 3) P33 = level;  // 直接赋值bit变量，完全合法
  63   2                  else return 1;
  64   2                  break;
  65   2              case 5:
  66   2                  if(pin == 4)      P54 = level;
  67   2                  else if(pin == 5) P55 = level;
  68   2                  else return 1;
  69   2                  break;
  70   2              default:
  71   2                  return 1;
  72   2          }
  73   1          return 0;  // 成功返回1（和你之前的返回值逻辑一致，不用改调用代码）
  74   1      }


