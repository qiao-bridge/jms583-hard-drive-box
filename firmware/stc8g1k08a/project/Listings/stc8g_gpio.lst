   4          /**
   5           * @brief STC8G系列GPIO引脚初始化函数
   6           * @note  仅适配STC8G1K08系列，该芯片仅开放P1、P3、P5三个IO口
   7           * @param port  端口号：仅支持1(P1口)、3(P3口)、5(P5口)，其他值返回初始化失败
   8           * @param pin   引脚号：0~7，超出范围返回初始化失败
   9           * @param mode  GPIO工作模式，对应STC硬件寄存器定义：
  10           *              - 0：准双向口（M1=0, M0=0）：传统8051模式，内部弱上拉(~100uA)，适合按键输入、普通IO
  11           *              - 1：推挽输出（M1=0, M0=1）：强驱动(~20mA)，适合LED、PWM输出、串口TX
  12           *              - 2：高阻输入（M1=1, M0=0）：无内部上拉，适合ADC采样、高频信号输入
  13           *              - 3：开漏输出（M1=1, M0=1）：需外接上拉电阻，适合I2C总线、电平匹配
  14           * @return bit  初始化结果：1=成功，0=参数非法（端口不支持/引脚超范围）
  15           */
  16          bit stc8g_gpio_init(unsigned char port, unsigned char pin, unsigned char mode){
  17   1              
  18   1              unsigned char mask = 0x01 << pin;
  19   1              
  20   1              if(pin >7) return 0;
  21   1              switch(mode){
  22   2                      case 0://准双向口: M1=0, M0=0
  23   2                              if(port == 1)           { P1M1 &= ~mask; P1M0 &= ~mask;}
  24   2                              else if(port == 3)  { P3M1 &= ~mask; P3M0 &= ~mask;}
  25   2                              else if(port == 5)  { P5M1 &= ~mask; P5M0 &= ~mask;}
  26   2                              else return 0;// STC8G1K08 只有 P1/P3/P5
  27   2                              break;
  28   2                      case 1:// 推挽输出: M1=0, M0=1
  29   2                              if(port == 1)           { P1M1 &= ~mask; P1M0|=mask;}
  30   2                              else if(port == 3)  { P3M1 &= ~mask; P3M0|=mask;}
  31   2                              else if(port == 5)  { P5M1 &= ~mask; P5M0|=mask;}
  32   2                              else return 0;
  33   2                              break;
  34   2                      case 2:// 高阻输入: M1=1, M0=0
  35   2                              if(port == 1)           { P1M1 |=mask; P1M0 &= ~mask;}
  36   2                              else if(port == 3)  { P3M1 |=mask; P3M0 &= ~mask;}
  37   2                              else if(port == 5)  { P5M1 |=mask; P5M0 &= ~mask;}
  38   2                              else return 0;
  39   2                              break;
  40   2                      default://开漏输出: M1=1, M0=1
  41   2                              if(port == 1)           { P1M1 |=mask; P1M0|=mask;}
  42   2                              else if(port == 3)  { P3M1 |=mask; P3M0|=mask;}
  43   2                              else if(port == 5)  { P5M1 |=mask; P5M0|=mask;}
  44   2                              else return 0;
  45   2                              break;
  46   2              }
  47   1              return 1; //初始化成功
  48   1      }
