  79   1          P_SW2 |= 0x80;
  80   1          ADCTIM = 0x3F;
  81   1          P_SW2 &= 0x7F;
  82   1          ADCCFG = 0x2F;
  83   1          ADC_CONTR = 0x8F;  // 内部 1.19V 通道
  84   1          _nop_(); _nop_(); _nop_(); _nop_();
  85   1          _nop_(); _nop_(); _nop_(); _nop_();
  86   1      }
  87          
  88          int adcreference(void)
  89          {
  90   1          unsigned char i;
  91   1          unsigned int res = 0;
  92   1          unsigned int adc_val = 0;
  93   1          ADCInitInside();
  94   1          ADC_ReadChannel(15);  // 丢弃第一次，通道15用于检测内部adc的参考电压
  95   1          for (i = 0; i < 8; i++) {
  96   2              res += ADC_ReadChannel(15);
  97   2          }
  98   1          adc_val = res / 8;
  99   1          return (1190UL * 1023UL) / adc_val;
 100   1      }
