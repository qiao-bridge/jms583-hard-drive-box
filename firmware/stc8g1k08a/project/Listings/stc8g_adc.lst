  76   1      }
  77          
  78          int adcreference(void)
  79          {
  80   1          unsigned char i;
  81   1          unsigned int res = 0;
  82   1          unsigned int adc_val = 0;
  83   1          ADCInitInside();
  84   1          ADC_ReadChannel(15);  // 丢弃第一次，通道15用于检测内部adc的参考电压
  85   1          for (i = 0; i < 8; i++) {
  86   2              res += ADC_ReadChannel(15);
  87   2          }
  88   1          adc_val = res / 8;
  89   1          return (1190UL * 1023UL) / adc_val;
  90   1      }
