  20          
  21          int ADC_ReadChannel(unsigned char channel)
  22          {
  23   1          int res;
  24   1          ADC_CONTR = (ADC_CONTR & 0xF0) | (channel & 0x0F);
  25   1          ADC_CONTR |= 0x40;  // adc转换启动控制位， 硬件自动清零
  26   1          _nop_(); _nop_();
  27   1          while (!(ADC_CONTR & 0x20)); // 等待adc采集完成
  28   1          ADC_CONTR &= ~0x20; //手动关闭adc标志位
  29   1          res = (ADC_RES << 8) | ADC_RESL;
  30   1          return res;
  31   1      }
  32          
  33          
  34          int ADC_SampleTemperatures(int *out_temps)
  35          {
  36   1          int adc_val[3];
  37   1          int temps[3];
  38   1          int i;
  39   1          int avg;
  40   1      
  41   1          // 1. 读取三路 ADC（每次读取前自动切换通道）加的系数代表实际芯片的温度要比测量的要搞一些
  42   1          adc_val[0] = ADC_ReadChannel(2) + 3;  // P3.2 - JMS583
  43   1          adc_val[1] = ADC_ReadChannel(3) + 7;  // P3.3 - DCDC
  44   1          adc_val[2] = ADC_ReadChannel(4) + 1;  // P5.4 - SSD
  45   1      
  46   1          // 2. ADC → 温度
  47   1          for (i = 0; i < 3; i++) {
  48   2              temps[i] = ntc_raw_to_temp(adc_val[i]);
  49   2          }
  50   1      
  51   1          // 3. 一阶低通滤波：out = out*(256-K)/256 + new*K/256
  52   1          for (i = 0; i < 3; i++) {
  53   2                      filtered_temps[i] = temps[i];
  54   2              //filtered_temps[i] = (filtered_temps[i] * (256 - FILTER_K) + temps[i] * FILTER_K) >> 8;
C51 COMPILER V9.54   STC8G_ADC                                                             08/31/2026 15:53:21 PAGE 2   

  55   2              out_temps[i] = filtered_temps[i];
  56   2          }
  57   1      
  58   1          // 4. 加权平均（权重之和 = 100）
  59   1          avg = (filtered_temps[SENSOR_JMS583] * WEIGHT_JMS583 +
  60   1                 filtered_temps[SENSOR_DCDC]   * WEIGHT_DCDC +
  61   1                 filtered_temps[SENSOR_SSD]    * WEIGHT_SSD) / 100;
  62   1      
  63   1          return avg;
  64   1      }
