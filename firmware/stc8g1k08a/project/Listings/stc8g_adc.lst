   9          bit ADCInit(void)
  10          {
  11   1          P_SW2 |= 0x80;
  12   1          ADCTIM = 0x3F;
  13   1          P_SW2 &= 0x7F;
  14   1          ADCCFG = 0x2F;          // 右对齐，时钟分频
  15   1          ADC_CONTR = 0x80;       // 开启 ADC 电源，不选通道
