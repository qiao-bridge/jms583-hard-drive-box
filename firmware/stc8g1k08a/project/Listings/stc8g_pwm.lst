  51          void stc8g_pwm_setduty(unsigned char percentage, unsigned char channel)
  52          {
  53   1              //注意：在更新 10 位 PWM 的重载值时，必须先写高两位 XCCAPnH[1:0]，再写低 8 位 CCAPnH[7:0]。
C51 COMPILER V9.54   STC8G_PWM                                                             08/30/2026 23:27:10 PAGE 2   

  54   1              unsigned char perc = (percentage > 100) ? 100 : percentage;
  55   1              unsigned short compare;
  56   1              
  57   1              switch(channel){
  58   2                      case 0:
  59   2                              //失能PCA模块0_PWM输出
  60   2                              CCAPM0   = 0x40;  
  61   2                      
  62   2                              if (perc == 0) {
  63   3                      // 0% 恒低：先清EPCnH/EPCnL，再置EPCnL=1（只开低开关）
  64   3                      PCA_PWM0 = (PCA_PWM0 & ~0xC0) | 0x40;  // ? 就改了这行掩码，原来是~0x30
  65   3                      CCAP0H = 0xFF;
  66   3                  } else if (perc >= 100) {
  67   3                      // 100% 恒高：先清EPCnH/EPCnL，再置EPCnH=1（只开高开关）
  68   3                      PCA_PWM0 = (PCA_PWM0 & ~0xC0) | 0x80;  // ? 就改了这行掩码，原来是~0x30
  69   3                      CCAP0H = 0x00;
  70   3                  } else {
  71   3                      // 正常占空比：EPC清0，计算比较值
  72   3                      compare = (100 - perc) * 1024 / 100;
  73   3                      PCA_PWM0 &= ~0xC0;   // EPC清0
  74   3                      PCA_PWM0 = (compare & ~0x30) | (((compare >> 8) & 0x03) << 4);
  75   3                      CCAP0H = compare & 0xFF;
  76   3                  }
  77   2                      
  78   2                              //使能PCA模块0_PWM输出
  79   2                              CCAPM0   = 0x42;      
  80   2                      break;
  81   2                      
  82   2                      case 1:
  83   2                              CCAPM1   = 0x40;           
  84   2                              
  85   2                              if (perc == 0) {
  86   3                      PCA_PWM1 = (PCA_PWM1 & ~0xC0) | 0x40;  // ? 仅改掩码
  87   3                      CCAP1H = 0xFF;
  88   3                  } else if (perc >= 100) {
  89   3                      PCA_PWM1 = (PCA_PWM1 & ~0xC0) | 0x80;  // ? 仅改掩码
  90   3                      CCAP1H = 0x00;
  91   3                  } else {
  92   3                      compare = (100 - perc) * 1024 / 100;
  93   3                      PCA_PWM1 &= ~0xC0;
  94   3                      PCA_PWM1 = (PCA_PWM1 & ~0x30) | (((compare >> 8) & 0x03) << 4);
  95   3                      CCAP1H = compare & 0xFF;
  96   3                  }
  97   2                      
  98   2                              CCAPM1   = 0x42;                
  99   2                      break;
 100   2                      
 101   2                      case 2:
 102   2                              CCAPM2   = 0x40;           
 103   2                              if (perc == 0) {
 104   3                      PCA_PWM2 = (PCA_PWM2 & ~0xC0) | 0x40;  // ? 仅改掩码
 105   3                      CCAP2H = 0xFF;
 106   3                  } else if (perc >= 100) {
