   3          /* --------------------------------------------------------
   4           * PCA 初始化 —— 10位 PWM，CCP0 通道
   5           * PCA 时钟 = SYSCLK/12 = 11.0592M/12 = 921.6kHz
   6           * PWM 频率 = 921.6k / 1024 ≈ 900 Hz（LED 调光够用）
   7           * 想拉高频率：CMOD 改 0x00(/1) → 10.8kHz，或切 8 位
   8           *--------------------------------------------------------*/
   9          void stc8g_pwm_init(unsigned char port, unsigned char pin, unsigned char channel)
  10          {
  11   1          // 1. IO 推挽
  12   1              stc8g_gpio_init(port, pin, 1);
  13   1      
  14   1          // 2. PCA 总控
  15   1          CCON  = 0x00;       // 关闭PCA计数器，清 CF/CCF0/1/2 标志
  16   1          CMOD  = 0x01;       // PCA 时钟 = SYSCLK/12，禁止溢出中断// 想用 /1(1T) 改 0x08，/4=0x02，/2=0x01     
             -                  
  17   1          CL = CH = 0x00;                     // 计数器清零
  18   1      
  19   1              // 3. CCP0 通道 → PWM 模式
  20   1              switch(channel){
  21   2                      case 0:
  22   2                              CCAPM0=0x42;    //ECOM=1 + PWM=1，使能比较 + PWM 输出
  23   2                              PCA_PWM0=0xC0;  //使能10位PWM输出
  24   2                              CCAP0L=0x00;    //捕获比较寄存器低8位，比较值（用于和ch、cl进行比较）
  25   2                              CCAP0H=0x00;    //捕获比较寄存器高8位，重装值（发生溢出，将重装值给到比较值）
  26   2                              
  27   2                      break;
  28   2                      
  29   2                      case 1:
  30   2                              CCAPM1=0x42;
  31   2                              PCA_PWM1=0xC0; 
  32   2                              CCAP1L=0x00;    
  33   2                              CCAP1H=0x00;    
  34   2                      break;
  35   2                      
  36   2                      case 2: 
  37   2                              CCAPM2=0x42; 
  38   2                              PCA_PWM2=0xC0; 
  39   2                              CCAP2L=0x00;    
  40   2                              CCAP2H=0x00;                            
  41   2                      break;
  42   2              }
  43   1          
  44   1          // 4. 启动
  45   1              CR=1;   //启动计数器
  46   1              
  47   1          //EA = 1;//在main函数中开启
  48   1      }
